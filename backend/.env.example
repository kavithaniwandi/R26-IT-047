
# ============================================
# Disaster Relief Backend - Example Environment
# Copy to .env and configure your local values
# ============================================

# Authentication
SECRET_KEY=replace-with-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite:///./disaster_relief.db
MONGODB_URL=
DATABASE_NAME=

# Application
APP_ENV=development
APP_TITLE=Disaster Relief Medical Donation Module API
APP_VERSION=1.0.0

# ============================================================
# Text.lk SMS Gateway (primary provider — replaces SMSGo)
# ============================================================
# Set TEXTLK_ENABLED=true and add your API token to activate.
# Keep this file committed; store the real token ONLY in .env (git-ignored).
# Free trial includes ~10 SMS units.  TextLKDemo is a testing sender ID only.
# API endpoint confirmed: https://app.text.lk/api/v3/sms/send
TEXTLK_ENABLED=false
TEXTLK_API_TOKEN=replace-with-your-text-lk-api-token
TEXTLK_API_URL=https://app.text.lk/api/v3/sms/send
TEXTLK_SENDER_ID=TextLKDemo
TEXTLK_TIMEOUT_SECONDS=15

# SMSGo.lk (legacy — retained for compatibility, not used when TEXTLK_ENABLED=true)
SMSGO_ENABLED=false
SMSGO_API_KEY=replace-with-your-smsgo-sandbox-key
SMSGO_MASK=
SMSGO_API_URL=https://api.smsgo.lk/api/v1/sms/send
SMSGO_TIMEOUT_SECONDS=15

# Emergency SMS identity strings
SMS_EMERGENCY_SHORTCODE=1919
SMS_SENDER_NAME=DISASTER-RELIEF

# Legacy Twilio configuration (retained for compatibility; not used by default)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
