# ============================================================
# .env.docker — Docker environment variables
# Used by docker-compose.yml
# ============================================================

# MySQL Settings
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=disaster_relief
MYSQL_USER=relief_user
MYSQL_PASSWORD=relief_pass

# JWT Settings
SECRET_KEY=disaster-relief-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App Meta
APP_ENV=development
APP_TITLE=Disaster Relief Medical Donation Module API
APP_VERSION=1.0.0
