            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Colombo General Relief Camp\",\n  \"latitude\": 6.921400,\n  \"longitude\": 79.852100,\n  \"district\": \"Colombo\",\n  \"ds_division\": \"Colombo\",\n  \"gn_division\": \"Slave Island\",\n  \"estimated_capacity\": 300\n}"
            },
            "url": { "raw": "{{api_v1}}/camps", "host": ["{{api_v1}}"], "path": ["camps"] }
