{
  "info": {
    "_postman_id": "disaster-relief-api-v1",
    "name": "Disaster Relief API — R26-IT-047",
    "description": "Complete API test suite for Disaster Relief Medical Donation Module (FastAPI + MySQL Docker).\n\n**Setup:**\n1. Run `docker-compose up --build`\n2. Set environment to `Local Docker`\n3. Run Auth > Login Admin to get token (auto-saved)\n\n**Base URL:** http://localhost:8000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "api_v1", "value": "http://localhost:8000/api/v1", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "🏥 Health Check",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status ok', () => { const b = pm.response.json(); pm.expect(b.status).to.eql('ok'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Test@12345!\",\n  \"phone\": \"+94701234567\",\n  \"address\": \"123 Test Lane, Colombo\"\n}"
            },
            "url": { "raw": "{{api_v1}}/auth/register", "host": ["{{api_v1}}"], "path": ["auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Register 201 or 200', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));"],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /auth/login — Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "admin@disaster.relief.lk" },
                { "key": "password", "value": "Admin@2026!" }
              ]
            },
            "url": { "raw": "{{api_v1}}/auth/login", "host": ["{{api_v1}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has access_token', () => pm.expect(json).to.have.property('access_token'));",
                  "pm.collectionVariables.set('access_token', json.access_token);",
                  "console.log('Token saved:', json.access_token.substring(0,30) + '...');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /auth/login — Donor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "donor@redcross.lk" },
                { "key": "password", "value": "Donor@2026!" }
              ]
            },
            "url": { "raw": "{{api_v1}}/auth/login", "host": ["{{api_v1}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "POST /auth/login — Victim",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "victim@kaduwela.lk" },
                { "key": "password", "value": "Victim@2026!" }
              ]
            },
            "url": { "raw": "{{api_v1}}/auth/login", "host": ["{{api_v1}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{api_v1}}/auth/me", "host": ["{{api_v1}}"], "path": ["auth", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has email', () => pm.expect(pm.response.json()).to.have.property('email'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "👥 Users",
      "item": [
        {
          "name": "GET /users — List All Users (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{api_v1}}/users?skip=0&limit=20",
              "host": ["{{api_v1}}"], "path": ["users"],
              "query": [{ "key": "skip", "value": "0" }, { "key": "limit", "value": "20" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /users/{id}",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{api_v1}}/users/1", "host": ["{{api_v1}}"], "path": ["users", "1"] }
          }
        },
        {
          "name": "PATCH /users/{id}/role (Admin Only)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{ \"role\": \"volunteer\" }" },
            "url": { "raw": "{{api_v1}}/users/5/role", "host": ["{{api_v1}}"], "path": ["users", "5", "role"] }
          }
        }
      ]
    },
    {
      "name": "🆘 SOS Alerts",
      "item": [
        {
          "name": "POST /sos — Create SOS Alert",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 6.936419,\n  \"longitude\": 79.957216,\n  \"district\": \"Colombo\",\n  \"ds_division\": \"Kaduwela\",\n  \"gn_division\": \"Ranala\",\n  \"address_text\": \"45 River View Lane, Ranala\",\n  \"urgency_level\": 5,\n  \"affected_people\": 18,\n  \"affected_families\": 4,\n  \"has_elderly\": true,\n  \"has_children\": true,\n  \"has_disabled\": true,\n  \"medical_needs_summary\": \"Insulin, Asthma Inhalers, First Aid Bandages\"\n}"
            },
            "url": { "raw": "{{api_v1}}/sos", "host": ["{{api_v1}}"], "path": ["sos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('SOS Created', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const b = pm.response.json();",
                  "if (b.id) pm.collectionVariables.set('sos_id', b.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /sos — List All SOS",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{api_v1}}/sos?skip=0&limit=20&status=active",
              "host": ["{{api_v1}}"], "path": ["sos"],
              "query": [
                { "key": "skip", "value": "0" },
                { "key": "limit", "value": "20" },
                { "key": "status", "value": "active" }
              ]
            }
          }
        },
        {
          "name": "GET /sos/{id}",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{api_v1}}/sos/1", "host": ["{{api_v1}}"], "path": ["sos", "1"] }
          }
        },
        {
          "name": "PATCH /sos/{id}/status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{ \"status\": \"resolved\" }" },
            "url": { "raw": "{{api_v1}}/sos/1/status", "host": ["{{api_v1}}"], "path": ["sos", "1", "status"] }
          }
        }
      ]
    },
